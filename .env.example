# Server (Express proxy) — copy to server/.env
OPENAI_API_KEY=sk-your-key-here
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Model selection (env-driven; see server/src/services/openai/openai.factory.ts)
EVALUATOR_MODEL=gpt-4o-mini
RESPONSE_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Web (Vite) — copy to web/.env
# Leave VITE_API_ORIGIN UNSET for same-origin /api (local dev uses the Vite proxy,
# Vercel uses the serverless function). Only set it to point at a backend on a
# different host, e.g. VITE_API_ORIGIN=http://localhost:4000
# VITE_API_ORIGIN=
